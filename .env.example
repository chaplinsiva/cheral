# ==========================================
# CHERAL SITE - ENVIRONMENT CONFIGURATION (EXAMPLE)
# Copy this file to .env.local and fill in the values
# ==========================================

# ------------------------------------------
# SUPABASE CONFIGURATION
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Supabase Service Role Key (Server-only / Admin operations, DO NOT expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------
# CLOUDFLARE R2 OBJECT STORAGE
# S3-Compatible Storage for images, gallery, and brochure PDFs
# Endpoint format: https://<CLOUDFLARE_R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# ------------------------------------------
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=cheral-assets
# Public access URL (either your custom domain or pub-*.r2.dev URL)
NEXT_PUBLIC_CLOUDFLARE_R2_PUBLIC_URL=https://assets.cheraltrust.org
